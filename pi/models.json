{
  "providers": {
    "abliteration": {
      "name": "Abliteration AI",
      "baseUrl": "https://api.abliteration.ai/v1",
      "api": "openai-completions",
      "apiKey": "$ABLITERATION_API_KEY",
      "models": [
        { "id": "abliterated-model", "name": "Abliterated Model", "reasoning": true, "input": ["text", "image"], "contextWindow": 262144, "maxTokens": 32768, "cost": { "input": 1, "output": 3, "cacheRead": 0.1, "cacheWrite": 0 } },
        { "id": "abliterated-model-large", "name": "Abliterated Large", "reasoning": true, "input": ["text"], "contextWindow": 1000000, "maxTokens": 32768, "cost": { "input": 3, "output": 5, "cacheRead": 0.3, "cacheWrite": 0 } },
        { "id": "abliterated-model-large-v2", "name": "Abliterated Large v2", "reasoning": true, "input": ["text"], "contextWindow": 1000000, "maxTokens": 32768, "cost": { "input": 3, "output": 5, "cacheRead": 0.3, "cacheWrite": 0 } }
      ]
    }
  }
}
